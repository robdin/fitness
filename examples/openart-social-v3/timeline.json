  "cues": [
    {
      "text": "Your workout took an hour.",
      "spoken_start": 0.12,
      "spoken_end": 1.48,
      "scene": "hook",
      "start": 0.01999999999999999,
      "end": 1.54,
      "lines": [
        "Your workout took an hour."
      ],
      "cps": 17.105263157894736
    },
    {
      "text": "But where did that hour go?",
      "spoken_start": 1.6400000000000001,
      "spoken_end": 3.08,
      "scene": "hook",
      "start": 1.54,
      "end": 3.33,
      "lines": [
        "But where did that hour go?"
      ],
      "cps": 15.083798882681563
    },
    {
      "text": "An hour in the gym is not an hour of lifting.",
      "spoken_start": 3.48,
      "spoken_end": 5.8,
      "scene": "audit",
      "start": 3.38,
      "end": 6.05,
      "lines": [
        "An hour in the gym",
        "is not an hour of lifting."
      ],
      "cps": 16.853932584269664
    },
    {
      "text": "In this made-up example: fifteen minutes lifting.",
      "spoken_start": 6.2,
      "spoken_end": 8.84,
      "scene": "audit",
      "start": 6.1000000000000005,
      "end": 8.98,
      "lines": [
        "In this made-up example:",
        "fifteen minutes lifting."
      ],
      "cps": 17.01388888888889
    },
    {
      "text": "Twenty-five resting. Eight setting up.",
      "spoken_start": 9.08,
      "spoken_end": 11.319999999999999,
      "scene": "audit",
      "start": 8.98,
      "end": 11.299999999999999,
      "lines": [
        "Twenty-five resting.",
        "Eight setting up."
      ],
      "cps": 16.379310344827598
    },
    {
      "text": "And twelve waiting.",
      "spoken_start": 11.399999999999999,
      "spoken_end": 12.36,
      "scene": "audit",
      "start": 11.299999999999999,
      "end": 12.58,
      "lines": [
        "And twelve waiting."
      ],
      "cps": 14.843749999999988
    },
    {
      "text": "Those are four different problems.",
      "spoken_start": 12.68,
      "spoken_end": 14.2,
      "scene": "friction",
      "start": 12.58,
      "end": 14.34,
      "lines": [
        "Those are four different problems."
      ],
      "cps": 19.31818181818182
    },
    {
      "text": "Start with a delay you can actually change.",
      "spoken_start": 14.44,
      "spoken_end": 16.44,
      "scene": "friction",
      "start": 14.34,
      "end": 16.69,
      "lines": [
        "Start with a delay you can",
        "actually change."
      ],
      "cps": 18.29787234042552
    },
    {
      "text": "Like repeated trips for equipment.",
      "spoken_start": 16.94684807256236,
      "spoken_end": 18.62684807256236,
      "scene": "friction",
      "start": 16.84684807256236,
      "end": 18.87684807256236,
      "lines": [
        "Like repeated trips for equipment."
      ],
      "cps": 16.748768472906395
    },
    {
      "text": "A time audit is not a reason",
      "spoken_start": 19.02684807256236,
      "spoken_end": 20.62684807256236,
      "scene": "rest",
      "start": 18.926848072562358,
      "end": 20.60684807256236,
      "lines": [
        "A time audit is not a reason"
      ],
      "cps": 16.666666666666636
    },
    {
      "text": "to rush every rest period.",
      "spoken_start": 20.706848072562362,
      "spoken_end": 22.06684807256236,
      "scene": "rest",
      "start": 20.60684807256236,
      "end": 22.28684807256236,
      "lines": [
        "to rush every rest period."
      ],
      "cps": 15.476190476190478
    },
    {
      "text": "The biggest block is not automatically the problem.",
      "spoken_start": 22.386848072562362,
      "spoken_end": 25.026848072562363,
      "scene": "rest",
      "start": 22.28684807256236,
      "end": 25.276848072562363,
      "lines": [
        "The biggest block is not",
        "automatically the problem."
      ],
      "cps": 17.056856187290958
    },
    {
      "text": "For one session, log the four buckets.",
      "spoken_start": 25.42684807256236,
      "spoken_end": 27.66684807256236,
      "scene": "action",
      "start": 25.32684807256236,
      "end": 27.806848072562357,
      "lines": [
        "For one session,",
        "log the four buckets."
      ],
      "cps": 15.32258064516131
    },
    {
      "text": "Make one practical change.",
      "spoken_start": 27.906848072562358,
      "spoken_end": 29.346848072562363,
      "scene": "action",
      "start": 27.806848072562357,
      "end": 29.486848072562356,
      "lines": [
        "Make one practical change."
      ],
      "cps": 15.476190476190478
    },
    {
      "text": "Then compare the next session.",
      "spoken_start": 29.586848072562358,
      "spoken_end": 30.86684807256236,
      "scene": "action",
      "start": 29.486848072562356,
      "end": 31.11684807256236,
      "lines": [
        "Then compare the next session."
      ],
      "cps": 18.404907975460095
    },
    {
      "text": "Measure the friction before you rewrite the plan.",
      "spoken_start": 31.26684807256236,
      "spoken_end": 33.506848072562356,
      "scene": "action",
      "start": 31.11684807256236,
      "end": 33.56684807256235,
      "lines": [
        "Measure the friction",
        "before you rewrite the plan."
      ],
      "cps": 20.000000000000064
    },
    {
      "text": "Know why. Train better.",
      "spoken_start": 33.66684807256235,
      "spoken_end": 35.38308390022675,
      "scene": "close",
      "start": 33.56684807256235,
      "end": 35.63308390022675,
      "lines": [
        "Know why. Train better."
      ],
      "cps": 11.131352816584537
    }
  ],
